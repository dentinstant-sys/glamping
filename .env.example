# Royal Glamping — frontend público · variables de entorno
# Copiar a .env y rellenar con las llaves de Firebase (proyecto estelar-prod).
# Las llaves reales viven fuera del repo, en el almacén de credenciales del equipo.
# Las VITE_* se exponen al cliente (son públicas por diseño en Firebase web).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=estelar-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=estelar-prod
VITE_FIREBASE_STORAGE_BUCKET=estelar-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Origen público del sitio, SIN barra final.
# En producción: https://glampingroyal.com
# De aquí salen el canonical y og:url. Si se deja vacío, esas etiquetas no se
# emiten — preferible a publicar un canonical equivocado.
VITE_SITIO_URL=

# Poner en "true" para apuntar a los emuladores locales (QA con datos del seed).
VITE_USE_EMULATOR=false
